# Telegram Bot
BOT_TOKEN=your_bot_token_here
WEBAPP_URL=https://your-domain.com

# Database
DATABASE_URL=postgresql://taro:taro_secret@localhost:5432/taro_premium

# Auth
JWT_SECRET=change_me_to_random_secret_min_32_chars

# LLM (provider: openai | anthropic)
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Payments (provider: telegram | yukassa)
PAYMENT_PROVIDER=telegram
# YuKassa (if PAYMENT_PROVIDER=yukassa)
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
# Telegram Stars (if PAYMENT_PROVIDER=telegram)
TELEGRAM_PAYMENT_TOKEN=

# Static assets
CDN_BASE_URL=https://your-domain.com

# Admin (Telegram user IDs через запятую)
# Узнать свой ID: написать @userinfobot в Telegram
ADMIN_IDS=123456789,987654321

# Server
PORT=3000
NODE_ENV=production
